<text:h text:style-name="Heading_20_2" text:outline-level="2">RGPD</text:h>
<text:list text:style-name="List_20_1">
<text:list-item><text:p text:style-name="List_20_Bullet">Cookies : Banniere obligatoire (opt-in analytics)</text:p></text:list-item>
<text:list-item><text:p text:style-name="List_20_Bullet">Donnees sensibles : Consentement explicite (KYC, paiements)</text:p></text:list-item>
<text:list-item><text:p text:style-name="List_20_Bullet">Marketing : Opt-in separe (newsletters)</text:p></text:list-item>
<text:list-item><text:p text:style-name="List_20_Bullet">Conservation limitee : 90 jours apres expiration (annonces)</text:p></text:list-item>
<text:list-item><text:p text:style-name="List_20_Bullet">Droit a l'oubli : Suppression sur demande (moins de 30 jours)</text:p></text:list-item>
</text:list>
<text:p text:style-name="Standard"/>

<text:h text:style-name="Heading_20_2" text:outline-level="2">KYC et Age</text:h>
<text:h text:style-name="Heading_20_3" text:outline-level="3">Mineurs (16-17 ans)</text:h>
<text:list text:style-name="List_20_1">
<text:list-item><text:p text:style-name="List_20_Bullet">Plafond investissement : 200 EUR cumules</text:p></text:list-item>
<text:list-item><text:p text:style-name="List_20_Bullet">Retraits : Differes jusqu'a 18 ans (sauf autorisation parentale)</text:p></text:list-item>
<text:list-item><text:p text:style-name="List_20_Bullet">KYC renforce : Obligatoire a la majorite (transition automatique)</text:p></text:list-item>
</text:list>

<text:h text:style-name="Heading_20_3" text:outline-level="3">Majeurs</text:h>
<text:list text:style-name="List_20_1">
<text:list-item><text:p text:style-name="List_20_Bullet">KYC standard : Piece d'identite + justificatif domicile</text:p></text:list-item>
<text:list-item><text:p text:style-name="List_20_Bullet">Depot &gt; 1 000 EUR -&gt; KYC obligatoire</text:p></text:list-item>
<text:list-item><text:p text:style-name="List_20_Bullet">Retrait &gt; 500 EUR -&gt; KYC + verification bancaire</text:p></text:list-item>
</text:list>
<text:p text:style-name="Standard"/>

