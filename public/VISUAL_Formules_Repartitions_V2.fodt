<text:p text:style-name="Standard"/>

<!-- ═══════════════════════════════════════════════ -->
<!-- 12. API & SETTLEMENT -->
<!-- ═══════════════════════════════════════════════ -->
<text:h text:style-name="Heading_20_1" text:outline-level="1">12. API et Settlement (Reference Technique)</text:h>

<text:h text:style-name="Heading_20_2" text:outline-level="2">Endpoints Principaux</text:h>

<text:h text:style-name="Heading_20_3" text:outline-level="3">A) Investissement</text:h>
<text:p text:style-name="Standard">POST /api/stripe/invest</text:p>
<text:p text:style-name="Standard">Body: { category: &quot;films&quot;|&quot;livres&quot;|&quot;podcasts&quot;, targetId, amount, currency: &quot;EUR&quot; }</text:p>
<text:p text:style-name="Standard">-&gt; Credite votes selon bareme + VISUpoints</text:p>
<text:p text:style-name="Standard">-&gt; Roles autorises : investor, investireader, listener</text:p>
<text:p text:style-name="Standard"/>

<text:h text:style-name="Heading_20_3" text:outline-level="3">B) Vente Unitaire</text:h>
<text:p text:style-name="Standard">POST /api/sale</text:p>
<text:p text:style-name="Standard">Body: { category: &quot;voix_info&quot;|&quot;livres&quot;|&quot;podcasts&quot;, targetId, price, currency, buyerId }</text:p>
<text:p text:style-name="Standard">-&gt; Split 70/30 immediat (auteur/VISUAL)</text:p>
<text:p text:style-name="Standard"/>

<text:h text:style-name="Heading_20_3" text:outline-level="3">C) Cloture de Cycle</text:h>
<text:p text:style-name="Standard">POST /api/payout/execute</text:p>
<text:p text:style-name="Standard">Authorization: Bearer {ADMIN_TOKEN}</text:p>
<text:p text:style-name="Standard">Body: { contentId, category }</text:p>
<text:p text:style-name="Standard">-&gt; Fige pot -&gt; Calcule payouts selon formules par categorie -&gt; Webhooks Stripe Connect</text:p>
<text:p text:style-name="Standard"/>

<text:h text:style-name="Heading_20_2" text:outline-level="2">Moteur de Settlement (payout-engine.ts)</text:h>
<text:p text:style-name="Standard">Le moteur est multi-categories. L'entree inclut un champ 'category' qui determine la formule :</text:p>
<table:table table:name="SettlementCategories" table:style-name="TableStyle">
<table:table-column/><table:table-column/><table:table-column/>
<table:table-header-rows><table:table-row>
<table:table-cell table:style-name="TableHeader" office:value-type="string"><text:p text:style-name="Table_20_Contents">Categorie</text:p></table:table-cell>
<table:table-cell table:style-name="TableHeader" office:value-type="string"><text:p text:style-name="Table_20_Contents">Formule</text:p></table:table-cell>
<table:table-cell table:style-name="TableHeader" office:value-type="string"><text:p text:style-name="Table_20_Contents">Frequence</text:p></table:table-cell>
</table:table-row></table:table-header-rows>
<table:table-row>
<table:table-cell table:style-name="TableCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">films</text:p></table:table-cell>
<table:table-cell table:style-name="TableCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">40/30/7/23 (rank-weighted BPS)</text:p></table:table-cell>
<table:table-cell table:style-name="TableCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">Configurable (admin)</text:p></table:table-cell>
</table:table-row>
<table:table-row>
<table:table-cell table:style-name="TableCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">voix_info</text:p></table:table-cell>
<table:table-cell table:style-name="TableCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">60/40 (pot quotidien)</text:p></table:table-cell>
