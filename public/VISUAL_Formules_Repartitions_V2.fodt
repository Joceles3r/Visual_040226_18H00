<text:list-item><text:p text:style-name="List_20_Bullet">Retrait minimum : 25 EUR</text:p></text:list-item>
<text:list-item><text:p text:style-name="List_20_Bullet">Delai de traitement des retraits : 7 jours</text:p></text:list-item>
<text:list-item><text:p text:style-name="List_20_Bullet">Type de compte Stripe Connect : Express</text:p></text:list-item>
</text:list>
<text:p text:style-name="Standard"/>

