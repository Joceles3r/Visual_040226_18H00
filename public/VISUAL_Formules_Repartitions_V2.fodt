<table:table-cell table:style-name="TableCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">2 EUR/clip</text:p></table:table-cell>
</table:table-row>
<table:table-row>
<table:table-cell table:style-name="TableCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">Documentaires</text:p></table:table-cell>
<table:table-cell table:style-name="TableCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">5-30 min</text:p></table:table-cell>
<table:table-cell table:style-name="TableCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">1 par mois</text:p></table:table-cell>
<table:table-cell table:style-name="TableCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">5 EUR/documentaire</text:p></table:table-cell>
</table:table-row>
<table:table-row>
