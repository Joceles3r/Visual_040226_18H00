<text:h text:style-name="Heading_20_2" text:outline-level="2">Regles de conversion</text:h>
<text:list text:style-name="List_20_1">
<text:list-item><text:p text:style-name="List_20_Bullet">Taux de conversion : 100 VISUpoints = 1 EUR</text:p></text:list-item>
<text:list-item><text:p text:style-name="List_20_Bullet">Seuil minimum de conversion : 2 500 VISUpoints (soit 25 EUR)</text:p></text:list-item>
<text:list-item><text:p text:style-name="List_20_Bullet">Formule : EUR_convertis = floor(VISUpoints / 100)</text:p></text:list-item>
<text:list-item><text:p text:style-name="List_20_Bullet">Points restants = VISUpoints - (EUR_convertis x 100)</text:p></text:list-item>
</text:list>
<text:p text:style-name="Standard"/>

<!-- ═══════════════════════════════════════════════ -->
<!-- 4. CAUTIONS -->
<!-- ═══════════════════════════════════════════════ -->
<text:h text:style-name="Heading_20_1" text:outline-level="1">4. Cautions</text:h>
<table:table table:name="Cautions" table:style-name="TableStyle">
<table:table-column/><table:table-column/><table:table-column/>
<table:table-header-rows><table:table-row>
<table:table-cell table:style-name="TableHeader" office:value-type="string"><text:p text:style-name="Table_20_Contents">Type de profil</text:p></table:table-cell>
