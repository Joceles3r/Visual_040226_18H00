<text:h text:style-name="Heading_20_2" text:outline-level="2">Idempotence Webhooks Stripe</text:h>
<text:list text:style-name="List_20_1">
<text:list-item><text:p text:style-name="List_20_Bullet">Chaque webhook est verifie par event.id dans la table webhook_events</text:p></text:list-item>
<text:list-item><text:p text:style-name="List_20_Bullet">Si deja traite -&gt; HTTP 200 sans retraitement</text:p></text:list-item>
<text:list-item><text:p text:style-name="List_20_Bullet">Protection contre les rejeux et doublons de paiement</text:p></text:list-item>
</text:list>
<text:p text:style-name="Standard"/>

